{
  "name": "@reviewpulse/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node --import ./scripts/preload-env.mjs ../../node_modules/next/dist/bin/next build --webpack",
    "dev": "node --import ./scripts/preload-env.mjs ../../node_modules/next/dist/bin/next dev --webpack",
    "start": "node --import ./scripts/preload-env.mjs ../../node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "bootstrap-admin": "node --import ./scripts/preload-env.mjs --import tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@reviewpulse/app-auth": "^0.0.0",
    "@reviewpulse/credentials": "^0.0.0",
    "@reviewpulse/crypto": "^0.0.0",
    "@reviewpulse/db": "*",
    "@reviewpulse/domain": "^0.0.0",
    "@reviewpulse/gitlab-client": "^0.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}

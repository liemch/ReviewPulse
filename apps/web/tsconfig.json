{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@reviewpulse/db": [
        "../../packages/db/src/index.ts"
      ],
      "@reviewpulse/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@reviewpulse/app-auth": [
        "../../packages/app-auth/src/index.ts"
      ],
      "@reviewpulse/crypto": [
        "../../packages/crypto/src/index.ts"
      ],
      "@reviewpulse/credentials": [
        "../../packages/credentials/src/index.ts"
      ],
      "@reviewpulse/gitlab-client": [
        "../../packages/gitlab-client/src/index.ts"
      ]
    },
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

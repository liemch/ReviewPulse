{
  "name": "@reviewpulse/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./load-env": {
      "types": "./src/load-env.ts",
      "import": "./src/load-env.ts",
      "default": "./src/load-env.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./integration-test-setup": {
      "types": "./src/integration-test-setup.ts",
      "import": "./src/integration-test-setup.ts",
      "default": "./src/integration-test-setup.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "format": "prisma format",
    "validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "ready-smoke": "tsx src/ready-smoke.ts",
    "env:preflight": "tsx src/env-preflight.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "prisma": "^7.9.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}

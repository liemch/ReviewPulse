# PostgreSQL — local Docker Compose defaults (see docker-compose.yml).
# Replace USER/PASSWORD when not using the compose defaults.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/reviewpulse?schema=public

# AES-256-GCM key material (exactly 32 bytes when base64-decoded).
# Generate: openssl rand -base64 32
# Leave empty until WP1; do not commit real values.
TOKEN_ENCRYPTION_KEY=

# Label for the current encryption key (maps to integer key_version, e.g. v1 → 1).
# WP1 supports a single current key only — not full master-key rotation.
TOKEN_ENCRYPTION_KEY_VERSION=v1

# Opaque session entropy (min 32 characters). Generate: openssl rand -base64 48
# Required for WP3+. Do not commit real values.
SESSION_SECRET=

# Public web origin used for CSRF Origin checks (no trailing slash).
# Example: http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Set true behind HTTPS so cookies use Secure + __Host- prefix.
# Ignored when APP_ORIGIN is plain http:// (local) — S8 keeps rp_session there.
# COOKIE_SECURE=true

# Optional session policy (defaults match SPEC FR-APP3 / plan D8)
# SESSION_ABS_TTL_SECONDS=43200
# SESSION_IDLE_TTL_SECONDS=7200

# Bootstrap first admin (CLI only — never an HTTP endpoint):
#   BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#   BOOTSTRAP_ADMIN_PASSWORD_FILE=/secure/path/password.txt
#   npm run auth:bootstrap-admin

# Runtime allowlist for Settings is also stored in DB (WP4 admin UI).
# Optional here: comma-separated exact origins; prefix with `internal:` for RFC1918.
# Example: https://gitlab.example.com,internal:https://gitlab.corp.example
GITLAB_URL_ALLOWLIST=

# Optional membership cache TTL seconds (default 300)
# MEMBERSHIP_CACHE_TTL_SECONDS=300

# Optional commit sync lookback overlap seconds (default 900)
# COMMIT_LOOKBACK_OVERLAP_SECONDS=900

# App
# Do not set NODE_ENV in `.env` — Next.js / npm scripts own it (dev vs build).
PORT=3000

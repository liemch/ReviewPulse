# PostgreSQL — local Docker Compose defaults (see docker-compose.yml).
# Replace USER/PASSWORD when not using the compose defaults.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/reviewpulse?schema=public

# AES-256-GCM key material (exactly 32 bytes when base64-decoded).
# Generate: openssl rand -base64 32
# Leave empty until WP1; do not commit real values.
TOKEN_ENCRYPTION_KEY=

# Label for the current encryption key (maps to integer key_version, e.g. v1 → 1).
# WP1 supports a single current key only — not full master-key rotation.
TOKEN_ENCRYPTION_KEY_VERSION=v1

# Opaque session entropy (min 32 characters). Generate: openssl rand -base64 48
# Leave empty until WP3; do not commit real values.
SESSION_SECRET=

# Comma-separated allowlisted GitLab base URLs (normalized HTTPS hosts)
# Example: https://gitlab.example.com,https://gitlab.com
GITLAB_URL_ALLOWLIST=

# Optional session policy (defaults match plan)
# SESSION_ABS_TTL_SECONDS=43200
# SESSION_IDLE_TTL_SECONDS=7200

# Optional membership cache TTL seconds (default 300)
# MEMBERSHIP_CACHE_TTL_SECONDS=300

# Optional commit sync lookback overlap seconds (default 900)
# COMMIT_LOOKBACK_OVERLAP_SECONDS=900

# App
NODE_ENV=development
PORT=3000
